# Copy to .env for local use, or set these in your host's environment settings.
# The app runs fine without any of them: the assistant features just stay hidden.
GEMINI_API_KEY=
# Optional. Leave unset: the app picks a model this key can call and
# moves on by itself when Google retires one.
# GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=8
